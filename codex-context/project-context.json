  "commands": {
    "frontend_install": "cd frontend && npm ci",
    "frontend_start": "cd frontend && npm start",
    "frontend_build": "cd frontend && npm run build",
    "frontend_build_windows": "cd frontend; $env:DISABLE_ESLINT_PLUGIN=\"true\"; npm exec -- craco build; node scripts/postbuild-spa.cjs",
    "backend_install": "cd backend && pip install -r requirements.txt",
    "backend_start": "cd backend && uvicorn server:app --reload --host 0.0.0.0 --port 8000",
    "pdf_smoke_test": "cd backend && python scripts/test_pdf_export.py --lang ar",
    "backend_pytest": "cd backend && pytest"
  },
