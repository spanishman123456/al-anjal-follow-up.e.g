{
  "project_name": "Al Anjal School Follow-up Record",
  "project_type": "Bilingual school academic follow-up / assessment web app",
  "purpose": "Track weekly follow-up marks, quizzes, chapter tests, quarter exams, performance levels, analytics, and admin reports for Al Anjal National Schools",
  "handoff_date": "2026-08-21",
  "baseline_verified_date": "2026-08-22",
  "tech_stack": {
    "frontend": ["React CRA", "Craco", "Tailwind CSS", "shadcn/Radix", "Recharts", "Axios", "HashRouter"],
    "backend": ["FastAPI", "Uvicorn", "Motor", "PyMongo", "Pydantic v2", "PyJWT", "Passlib/bcrypt", "ReportLab", "Matplotlib", "pandas", "APScheduler"],
    "database": "MongoDB",
    "auth": ["JWT Bearer HS256", "Optional Google ID token + admin Gmail approval"],
    "hosting": "Render (render.yaml)"
  },
  "frontend_root": "frontend/",
  "backend_root": "backend/",
  "main_entities": [
    "users",
    "roles",
    "classes",
    "students",
    "weeks",
    "student_scores",
    "remedial_plans",
    "rewards",
    "reward_events",
    "audit_logs",
    "app_settings",
    "calendar_events",
    "notification_logs",
    "report_settings"
  ],
  "key_features": [
    "Student and class management",
    "Weekly follow-up scores including attendance-as-points",
    "Quizzes, chapter tests, final practical/theory",
    "Performance levels on_level/approach/below/no_data",
    "Analytics and Reports with PDF/Excel",
    "Remedial plans and rewards certificates",
    "Lesson plan generator",
    "Teachers profiles and Gmail approval",
    "Calendar and notifications",
    "Global semester/quarter sync",
    "EN/AR RTL UI with PageHero banners"
  ],
  "not_implemented": [
    "Daily present/absent attendance roll-call system"
  ],
  "important_directories": [
    "frontend/src/pages",
